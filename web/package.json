{
  "name": "web",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run __tests__/unit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "prettier --write . && eslint . --fix",
    "design:map": "node scripts/reference-map.mjs",
    "design:report": "node scripts/visual-report.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@nuxt/test-utils": "^4.4.0",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "nuxt": "^4.6.3",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vee-validate": "^5.0.0-beta.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "esbuild": false
  }
}
